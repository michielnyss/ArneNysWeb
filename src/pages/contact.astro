---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import portrait from '../assets/site/contact.jpg';

const bio = [
  'Arne Nys (b. 1998) is a Belgian artist living and working in Lichtaart. He works across sculpture, drawing, printmaking, and painting, exploring the relationship between material, time, and transformation.',
  'Inspired by aquatic environments and natural processes such as flow, erosion, and renewal, his works evolve through cycles of building, painting, cutting, and reworking. These layered processes leave visible traces of time and reflect on deeper personal and societal undercurrents.',
  'Nys approaches his practice intuitively and experimentally, allowing control and chance to interact. His works function like small ecosystems in which matter, thought, space, and time continuously influence one another.',
];
---

<Base
  title="Contact"
  description="Arne Nys (b. 1998) is a Belgian artist living and working in Lichtaart."
  theme="sage"
>
  <div class="contact">
    <Image
      class="portrait"
      src={portrait}
      alt="Arne Nys in the studio"
      widths={[600, 900, 1200]}
      sizes="(max-width: 767px) 88vw, 38vw"
    />

    <div class="bio">
      {bio.map((para) => <h3>{para}</h3>)}
    </div>
  </div>
</Base>

<style>
  /*
   * The live page is one centred column: the portrait on top, the text below
   * it in a slightly wider measure.
   */
  .contact {
    padding-inline: var(--gutter);
    padding-top: 129px;
    display: grid;
    justify-items: center;
    gap: 53px;
  }

  .contact :global(.portrait) {
    width: 100%;
    max-width: 545px;
    height: auto;
  }

  .bio {
    width: 100%;
    max-width: 693px;
    display: grid;
    gap: 24px;
  }
  /* The live site sets these paragraphs as headings, at heading size. */
  .bio h3 {
    color: var(--cream);
    font-family: var(--serif);
    font-size: clamp(1.05rem, 1.553vw, 1.7rem);
    line-height: 1.171;
    letter-spacing: -0.02em;
    font-weight: 400;
  }

  @media (max-width: 767px) {
    .contact {
      padding-top: clamp(2rem, 9vh, 4rem);
      gap: clamp(2rem, 5vh, 3.5rem);
    }
  }
</style>
