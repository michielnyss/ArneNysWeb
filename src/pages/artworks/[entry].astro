---
import { Image } from 'astro:assets';
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import ArtworkGrid from '../../components/ArtworkGrid.astro';
import YearFilter from '../../components/YearFilter.astro';
import { sortArtworks, yearsOf } from '../../lib/artworks';

/**
 * Years and artwork slugs share the /artworks/ namespace, so one route
 * resolves both: /artworks/2024/ lists a year, /artworks/tijdstroom/ is a work.
 */
export async function getStaticPaths() {
  const artworks = sortArtworks(await getCollection('artworks'));
  const years = yearsOf(artworks);

  return [
    ...years.map((year) => ({
      params: { entry: String(year) },
      props: { kind: 'year' as const, year, artworks: artworks.filter((a) => a.data.year === year) },
    })),
    ...artworks.map((work) => ({
      params: { entry: work.id },
      props: { kind: 'work' as const, work },
    })),
  ];
}

type Props =
  | { kind: 'year'; year: number; artworks: CollectionEntry<'artworks'>[] }
  | { kind: 'work'; work: CollectionEntry<'artworks'> };

const props = Astro.props as Props;
const allYears = yearsOf(sortArtworks(await getCollection('artworks')));

/** The caption block under the title, in the order the live site prints it. */
const captionLines =
  props.kind === 'work'
    ? [
        props.work.data.dimensions,
        props.work.data.medium,
        props.work.data.year ? String(props.work.data.year) : '',
        props.work.data.status,
      ].filter(Boolean)
    : [];
---

{
  props.kind === 'year' ? (
    <Base title={`Artworks ${props.year}`} headerOverlay>
      <Hero />
      <div class="wrap">
        <YearFilter years={allYears} active={props.year} />
        <ArtworkGrid artworks={props.artworks} />
      </div>
    </Base>
  ) : (
    <Base
      title={props.work.data.title}
      description={
        props.work.data.description ||
        (captionLines.length
          ? `${props.work.data.title} — ${captionLines.join(', ')}. A work by Arne Nys.`
          : `${props.work.data.title}, a work by Arne Nys`)
      }
      theme="sage"
      jsonLd={[
        {
          '@type': 'VisualArtwork',
          name: props.work.data.title,
          creator: { '@id': new URL('/#arne-nys', Astro.site).href },
          ...(props.work.data.year ? { dateCreated: String(props.work.data.year) } : {}),
          ...(props.work.data.medium ? { artMedium: props.work.data.medium } : {}),
          ...(props.work.data.dimensions ? { size: props.work.data.dimensions } : {}),
          url: new URL(`/artworks/${props.work.id}/`, Astro.site).href,
        },
      ]}
    >
      <nav class="crumbs wrap" aria-label="Breadcrumb">
        <a href="/">Artworks</a>
        <span aria-hidden="true">›</span>
        <span aria-current="page">{props.work.data.title}</span>
      </nav>

      <article class="work wrap">
        <div class="plates">
          {props.work.data.gallery.map((img, i) => (
            <Image
              src={img.src}
              alt={img.alt || props.work.data.title}
              widths={[600, 900, 1400]}
              sizes="(max-width: 900px) 100vw, 63vw"
              loading={i === 0 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : undefined}
            />
          ))}
        </div>

        <aside class="details">
          <h1>{props.work.data.title}</h1>
          {captionLines.map((line) => (
            <p class="line">{line}</p>
          ))}
          {props.work.data.description && <p class="blurb">{props.work.data.description}</p>}
        </aside>
      </article>
    </Base>
  )
}

<style>
  /* Breadcrumb sits 43px under the header, 22px above the first plate. */
  .crumbs {
    display: flex;
    gap: 0.55rem;
    padding-top: clamp(1.5rem, 3vw, 3rem);
  }
  .crumbs a:hover {
    border-bottom: 1px solid currentColor;
  }

  /* Measured off the live page: 65% plate column, 2% gutter, 33% caption. */
  .work {
    display: grid;
    grid-template-columns: 65% minmax(0, 1fr);
    gap: var(--gap);
    align-items: start;
    padding-top: 22px;
  }

  .plates {
    display: grid;
    gap: var(--gap);
  }

  /* The live caption column tracks the plates as they scroll past. */
  .details {
    text-align: center;
    position: sticky;
    top: 20px;
  }
  .details h1 {
    color: var(--cream);
    font-size: clamp(1.6rem, 3.233vw, 3.6rem);
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .line {
    margin: 0;
    padding-top: 12px;
    color: var(--cream);
  }
  .line:first-of-type {
    padding-top: 22px;
  }

  .blurb {
    margin: 1.75rem auto 0;
    max-width: 34ch;
  }

  @media (max-width: 900px) {
    .work {
      grid-template-columns: 1fr;
      gap: clamp(1.25rem, 4vw, 2rem);
    }
    .details {
      order: -1;
      position: static;
    }
  }
</style>
