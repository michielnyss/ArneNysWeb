---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ArtworkGrid from '../components/ArtworkGrid.astro';
import YearFilter from '../components/YearFilter.astro';
import { sortArtworks, yearsOf } from '../lib/artworks';

const artworks = sortArtworks(await getCollection('artworks'));
const years = yearsOf(artworks);
---

<Base title="Arne Nys" bareTitle headerOverlay>
  <Hero />

  <div class="wrap">
    <YearFilter years={years} active={null} />
    <ArtworkGrid artworks={artworks} />
  </div>
</Base>
