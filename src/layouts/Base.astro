---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Page background: cream (index, year lists) or sage (artwork, contact). */
  theme?: 'cream' | 'sage';
  /** The header sits over a full-bleed hero instead of above the content. */
  headerOverlay?: boolean;
  /** Use `title` verbatim instead of appending the site name. */
  bareTitle?: boolean;
  /** Absolute or root-relative image for social cards. */
  image?: string;
  /** Extra structured data merged into the page's JSON-LD graph. */
  jsonLd?: Record<string, unknown>[];
}

const SITE_NAME = 'Atelier Nys';

const {
  title,
  description = 'Arne Nys is a Belgian artist working across sculpture, drawing, printmaking, and painting',
  theme = 'cream',
  headerOverlay = false,
  bareTitle = false,
  image = '/og-image.jpg',
  jsonLd = [],
} = Astro.props;

const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site);
const socialImage = new URL(image, Astro.site);
const pageTitle = bareTitle ? title : `${title} — ${SITE_NAME}`;

const nav = [
  { label: 'Artworks', href: '/' },
  { label: 'Contact', href: '/contact/' },
];
const isCurrent = (href: string) =>
  href === '/' ? path === '/' || path.startsWith('/artworks') : path.startsWith(href);

const graph = [
  {
    '@type': 'WebSite',
    '@id': new URL('/#website', Astro.site).href,
    name: SITE_NAME,
    url: new URL('/', Astro.site).href,
    inLanguage: 'en',
  },
  {
    '@type': 'Person',
    '@id': new URL('/#arne-nys', Astro.site).href,
    name: 'Arne Nys',
    birthDate: '1998',
    jobTitle: 'Artist',
    nationality: 'Belgian',
    description,
    url: new URL('/', Astro.site).href,
    sameAs: ['https://www.instagram.com/nysarne/'],
    address: { '@type': 'PostalAddress', addressLocality: 'Lichtaart', addressCountry: 'BE' },
    email: 'arnenys129@gmail.com',
  },
  ...jsonLd,
];
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="icon" href="/favicon.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#191713" />

    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    <link rel="sitemap" href="/sitemap-index.xml" />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })}
    />
  </head>
  <body data-theme={theme}>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class:list={['site-header', { overlay: headerOverlay }]} data-header>
      <div class="header-inner wrap">
        <button
          class="burger"
          type="button"
          aria-expanded="false"
          aria-controls="site-nav"
          data-burger
        >
          <span class="burger-box" aria-hidden="true"><span></span><span></span></span>
          <span class="sr-only">Menu</span>
        </button>

        <nav id="site-nav" aria-label="Main">
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-inner">
        <a href="mailto:arnenys129@gmail.com">arnenys129@gmail.com</a>
        <a href="https://www.instagram.com/nysarne/" rel="me noopener" target="_blank">Instagram</a>
      </div>
    </footer>

    <script>
      const header = document.querySelector('[data-header]');
      const burger = document.querySelector('[data-burger]');

      /* The live header slides away as soon as the page is scrolled, and only
         comes back at the very top. */
      if (header) {
        const threshold = header.getBoundingClientRect().height;
        const onScroll = () =>
          header.classList.toggle('is-tucked', window.scrollY > threshold);
        onScroll();
        addEventListener('scroll', onScroll, { passive: true });
      }

      if (burger && header) {
        const close = () => {
          header.classList.remove('nav-open');
          burger.setAttribute('aria-expanded', 'false');
        };
        burger.addEventListener('click', () => {
          const open = header.classList.toggle('nav-open');
          burger.setAttribute('aria-expanded', String(open));
        });
        addEventListener('keydown', (e) => e.key === 'Escape' && close());
        header.querySelectorAll('#site-nav a').forEach((a) => a.addEventListener('click', close));
      }
    </script>
    <noscript>
      <style>
        /* Without JS the header cannot tuck away, so keep it out of the flow of
           the content it would otherwise cover. */
        .site-header {
          position: absolute;
        }
      </style>
    </noscript>

    <style>
      body[data-theme='sage'] {
        background: var(--sage);
        color: var(--cream);
      }

      /* Matches the live header: 83px at 1440, transparent, above everything. */
      .site-header {
        --header-h: clamp(58px, 5.76vw, 96px);
        position: fixed;
        inset-inline: 0;
        top: 0;
        z-index: 20;
        height: var(--header-h);
        color: var(--cream);
        transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
      }
      .site-header.is-tucked:not(.nav-open) {
        transform: translateY(-100%);
      }
      /* Over the hero the type needs a scrim; elsewhere the page is dark enough. */
      .site-header.overlay::before {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(to bottom, rgb(25 23 19 / 62%), rgb(25 23 19 / 0%));
        pointer-events: none;
      }

      /* Pages without a hero start below the fixed header. */
      body:not(:has(.site-header.overlay)) main {
        padding-top: clamp(58px, 5.76vw, 96px);
      }

      .header-inner {
        position: relative;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 1.5rem;
      }

      nav ul {
        display: flex;
        align-items: center;
        gap: 1.75rem;
        margin: 0;
        padding: 0;
        list-style: none;
      }
      nav a {
        color: var(--cream);
        font-size: var(--ui);
        letter-spacing: 0.01em;
        padding-block: 0.15rem;
        border-bottom: 1px solid transparent;
      }
      nav a[aria-current='page'],
      nav a:hover {
        border-bottom-color: currentColor;
      }

      .burger {
        display: none;
        appearance: none;
        background: none;
        border: 0;
        padding: 0.6rem 0;
        color: inherit;
        cursor: pointer;
      }
      .burger-box {
        display: grid;
        gap: 6px;
        width: 30px;
      }
      .burger-box span {
        display: block;
        height: 1px;
        background: currentColor;
        transition: transform 0.25s, opacity 0.25s;
      }
      .nav-open .burger-box span:first-child {
        transform: translateY(3.5px) rotate(45deg);
      }
      .nav-open .burger-box span:last-child {
        transform: translateY(-3.5px) rotate(-45deg);
      }

      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
      }

      .site-footer {
        margin-top: clamp(4rem, 12vh, 9rem);
        padding-block: 2.5rem 3rem;
      }
      .footer-inner {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 2rem;
      }
      .footer-inner a {
        border-bottom: 1px solid transparent;
      }
      .footer-inner a:hover {
        border-bottom-color: currentColor;
      }

      /* The live site collapses the nav into a burger below 768px. */
      @media (max-width: 768px) {
        .burger {
          display: block;
        }
        #site-nav {
          position: absolute;
          inset-inline: 0;
          top: 100%;
          background: var(--ink);
          display: grid;
          overflow: hidden;
          visibility: hidden;
          max-height: 0;
          transition: max-height 0.3s ease, visibility 0.3s;
        }
        .nav-open #site-nav {
          visibility: visible;
          max-height: 50vh;
        }
        #site-nav ul {
          flex-direction: column;
          align-items: stretch;
          gap: 0;
          padding: 0.5rem var(--gutter) 1.25rem;
        }
        #site-nav a {
          display: block;
          padding-block: 0.7rem;
          border-bottom: 0;
        }
      }
    </style>
  </body>
</html>
