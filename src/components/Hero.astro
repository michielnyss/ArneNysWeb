---
import { Image } from 'astro:assets';
import hero from '../assets/site/hero-home.png';
import { widthsUpTo } from '../lib/images';

/*
 * The banner covers the hero box, so whichever is larger fills it: the full
 * viewport width, or the box height times the photo's aspect ratio (on
 * phones, where the box is taller than it is wide). The heights repeat the
 * clamp()s in the style block below.
 *
 * The ratio is written out (hero-home.png is 2500x1576) because reading
 * hero.width would make Astro ship the 5 MB original PNG in dist/ as well.
 * For the same reason the widths are not capped here: Astro drops the ones
 * wider than the source and adds the source width itself.
 */
const ratio = 1.586;
const sizes = [
  `(max-width: 767px) max(100vw, calc(clamp(360px, 12vw + 60vh, 640px) * ${ratio}))`,
  `max(100vw, calc(clamp(320px, 24vw + 21vh, 720px) * ${ratio}))`,
].join(', ');
---

<section class="hero">
  <Image
    src={hero}
    alt=""
    widths={widthsUpTo(3600, 640)}
    sizes={sizes}
    loading="eager"
    fetchpriority="high"
  />
  <h1>Arne Nys</h1>
</section>

<style>
  /*
   * Height, crop and title position are measured off the live banner:
   * 536px tall at 1440x900, growing with both axes.
   */
  .hero {
    position: relative;
    height: clamp(320px, calc(24vw + 21vh), 720px);
    overflow: hidden;
  }
  .hero :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 48.8% 10.4%;
    /* Soften the bottom edge into the page background instead of a hard line. */
    -webkit-mask-image: linear-gradient(to bottom, #000 72%, transparent);
    mask-image: linear-gradient(to bottom, #000 72%, transparent);
  }
  .hero h1 {
    position: absolute;
    top: 54.9%;
    inset-inline: 0;
    margin: 0;
    text-align: center;
    color: var(--cream);
    font-size: clamp(1.9rem, 3.113vw, 4rem);
    line-height: 1.109;
    letter-spacing: -0.02em;
  }

  @media (max-width: 767px) {
    .hero {
      height: clamp(360px, calc(12vw + 60vh), 640px);
    }
  }
</style>
