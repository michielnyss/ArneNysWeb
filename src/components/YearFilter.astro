---
interface Props {
  years: number[];
  /** The active year, or null on the "all artworks" view. */
  active?: number | null;
}
const { years, active = null } = Astro.props;
---

<nav class="years" aria-label="Filter by year">
  {
    years.map((year, i) => (
      <>
        {i > 0 && <span aria-hidden="true">|</span>}
        <a href={`/artworks/${year}/`} aria-current={active === year ? 'page' : undefined}>
          {year}
        </a>
      </>
    ))
  }
</nav>

<style>
  /* Sampled off the live grid: muted brown, 12px, ~70px between years. */
  .years {
    display: flex;
    justify-content: center;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 1.25rem;
    font-size: var(--ui);
    letter-spacing: 0.01em;
    color: var(--muted);
    padding-top: clamp(3rem, 10vw, 10rem);
    padding-bottom: 20px;
  }
  .years a {
    border-bottom: 1px solid transparent;
    padding-bottom: 2px;
  }
  .years a:hover,
  .years a[aria-current='page'] {
    border-bottom-color: currentColor;
  }
  .years span {
    opacity: 0.4;
  }
</style>
