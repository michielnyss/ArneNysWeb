---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  artworks: CollectionEntry<'artworks'>[];
}
const { artworks } = Astro.props;
---

<ul class="grid">
  {
    artworks.map((work) => {
      const cover = work.data.gallery[0];
      return (
        <li>
          <a href={`/artworks/${work.id}/`}>
            {cover && (
              <div class="frame">
                <Image
                  src={cover.src}
                  alt={cover.alt || work.data.title}
                  widths={[320, 480, 720, 960]}
                  sizes="(max-width: 600px) 50vw, (max-width: 1000px) 33vw, 23vw"
                  style={
                    cover.focalPoint
                      ? `object-position:${cover.focalPoint.x * 100}% ${cover.focalPoint.y * 100}%`
                      : undefined
                  }
                  loading="lazy"
                />
              </div>
            )}
            <span class="caption">{work.data.title}</span>
          </a>
        </li>
      );
    })
  }
</ul>

<style>
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(1rem, 2.4vw, 2.25rem) clamp(0.75rem, 1.6vw, 1.5rem);
  }

  .frame {
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: color-mix(in srgb, currentColor 6%, transparent);
  }
  .frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  a:hover .frame :global(img) {
    transform: scale(1.02);
  }

  .caption {
    display: block;
    margin-top: 0.7rem;
    font-size: 0.8125rem;
    letter-spacing: 0.01em;
    color: var(--ink);
  }
  :global(body[data-theme='sage']) .caption {
    color: var(--cream);
  }

  @media (max-width: 1000px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (max-width: 600px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
