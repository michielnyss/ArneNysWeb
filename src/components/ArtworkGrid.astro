---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { widthsUpTo } from '../lib/images';
import { focusPosition, gridImageSize } from '../lib/crop.js';

interface Props {
  artworks: CollectionEntry<'artworks'>[];
}
const { artworks } = Astro.props;
---

<ul class="grid">
  {
    artworks.map((work) => {
      const cover = work.data.gallery[0];
      // The frame is 2:3, so the build crops the cover to 2:3 itself (around
      // its focal point) and every pixel served is a pixel shown. `sizes` is
      // then simply the frame width: one column of four, or the full column
      // below 768px. 2040px covers a 3x phone and a 2x tablet.
      // gridImageSize (src/lib/crop.js) is also what the admin editor uses.
      const size = cover && gridImageSize(cover.src.width, cover.src.height);
      return (
        <li>
          <a href={`/artworks/${work.id}/`}>
            {cover && (
              <div class="frame">
                <Image
                  src={cover.src}
                  alt={cover.alt || work.data.title}
                  width={size.width}
                  height={size.height}
                  fit="cover"
                  position={focusPosition(cover.focalPoint)}
                  widths={widthsUpTo(size.width)}
                  sizes="(max-width: 767px) 88vw, 23vw"
                  loading="lazy"
                />
              </div>
            )}
            <span class="caption">{work.data.title}</span>
          </a>
        </li>
      );
    })
  }
</ul>

<style>
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--gap);
  }

  /* The live thumbnails are a 2:3 portrait crop at every viewport width. */
  .frame {
    aspect-ratio: 2 / 3;
    overflow: hidden;
    background: color-mix(in srgb, currentColor 6%, transparent);
  }
  .frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  a:hover .frame :global(img) {
    transform: scale(1.02);
  }

  /* Captions are set in the serif, not the UI sans. */
  .caption {
    display: block;
    margin-top: 1.375rem;
    font-family: var(--serif);
    font-size: 0.858rem;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: #000;
  }
  :global(body[data-theme='sage']) .caption {
    color: var(--cream);
  }

  /* The live grid goes straight from four columns to one below 768px. */
  @media (max-width: 767px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
