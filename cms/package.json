{
  "name": "arnenys-admin",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "dev": "wrangler dev -c wrangler.local.jsonc --port 8787",
    "dev:mock": "node build.mjs && node test/mock-server.mjs",
    "dev:archive": "node build.mjs && node test/mock-server.mjs --drive=real",
    "dev:archive:write": "node build.mjs && node test/mock-server.mjs --drive=real --write",
    "archive:headers": "node test/archive-headers.mjs",
    "test":"node --test \"test/**/*.test.mjs\"",
    "check-schema": "node test/schema-check.mjs",
    "deploy": "node build.mjs && wrangler deploy"
  },
  "devDependencies": {
    "@jsquash/jpeg": "^1.6.0",
    "esbuild": "^0.25.10",
    "libheif-js": "^1.19.8",
    "sortablejs": "^1.15.6",
    "wrangler": "^4.128.0"
  }
}
